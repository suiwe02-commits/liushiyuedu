{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/translate.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/translate",
      "dest": "/api/translate.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "VITE_BAIDU_APP_ID": "@baidu_app_id",
    "VITE_BAIDU_API_KEY": "@baidu_api_key"
  }
}
